__pycache__/
.runtime-tools/
*.pyc
.ipynb_checkpoints/
.DS_Store
backup/

# Data come from the Zenodo archives (see README) and are not tracked in git.
data/*

# PyMOL writes fetched structures into the working directory.
*.cif
*.zip
*.tar.gz

# Local PyMOL helpers; render_pair_examples.py is the one that belongs to the repository.
scripts/pymol_figures/*
!scripts/pymol_figures/render_pair_examples.py

# Notebook result caches (rebuilt automatically when data/ changes).
.cache/

# Local drawing files, not read by the notebooks.
figures/schematics/
